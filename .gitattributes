# Keep branch-specific Dockerfile, Docker Compose, Nginx, Env, and Deployment configs intact during git merges across all branches

# Docker & Container configs
docker-compose*.yml merge=ours
Dockerfile* merge=ours
.dockerignore merge=ours
**/Dockerfile* merge=ours
**/.dockerignore merge=ours
**/docker-compose*.yml merge=ours

# Nginx & Domain configs
nginx*.conf merge=ours
*.conf merge=ours
**/nginx*.conf merge=ours
**/*.conf merge=ours

# Environment & Secret files
.env* merge=ours
**/.env* merge=ours

# Deployment Scripts & Makefiles
Makefile merge=ours
makefile merge=ours
*.sh merge=ours
**/*.sh merge=ours

# Deployment documentation & Architecture specs
z_deployments.md merge=ours
z_architecture.md merge=ours
z_domainConnect.md merge=ours
z_git_architecture_guide.md merge=ours
z_gdrive_backup.md merge=ours
